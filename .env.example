# Zkopíruj tento soubor na ".env" a vyplň hodnoty.
# .env je v .gitignore — NIKDY se necommituje.
# V GitHub Actions tyto hodnoty NEJSOU z .env, ale z GitHub Secrets (viz README).

# --- Supabase ---
# Project Settings -> API
SUPABASE_URL=https://TVUJ-PROJEKT.supabase.co
# service_role klíč (TAJNÝ, plný přístup) — používá jen send.py / sync_books.py / generate.py
SUPABASE_SERVICE_KEY=eyJ...service_role...

# --- ntfy ---
# Volitelné: vlastní ntfy server. Výchozí je https://ntfy.sh
NTFY_SERVER=https://ntfy.sh
# Pozn.: ntfy TÉMATA jsou teď per odběratel v tabulce `subscribers`
# (sloupec ntfy_topic) v Supabase, ne tady. NTFY_TOPIC už není potřeba.

# --- Webová stránka ---
# Bez lomítka na konci. Sem míří proklik z notifikace.
SITE_BASE_URL=https://TVUJ-GITHUB-USERNAME.github.io/ranni-moudra

# --- Anthropic (jen pro generate.py) ---
ANTHROPIC_API_KEY=sk-ant-...
